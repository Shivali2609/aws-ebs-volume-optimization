  "States": {
    "InvokeLambda": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "lambda_handler",
        "Payload.$": "$"
      },
      "End": true
    }
  }
}
